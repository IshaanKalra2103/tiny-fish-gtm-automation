# Optional. vidgen reads these from the environment first, then the macOS Keychain
# (service name = variable name). In the harness container they come from harness/.env.
ELEVENLABS_API_KEY=
# Voice id or account voice name; default is the Keychain's ELEVENLABS_VOICE_MILES, then "miles"
ELEVENLABS_VOICE_ID=
# eleven_multilingual_v2 (default, best) or eleven_flash_v2_5 (half the credits)
ELEVENLABS_MODEL=
