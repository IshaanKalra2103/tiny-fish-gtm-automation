# Copied to .env by ./up.sh (secrets auto-generated). Never commit .env.
BETTER_AUTH_SECRET=
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=
# Signs the per-run tokens process agents get as PAPERCLIP_API_KEY.
PAPERCLIP_AGENT_JWT_SECRET=

# Provider keys. OPENAI_API_KEY is deliberately NOT here: export it in your shell or
# run `GTM_OPENAI_ENV_FILE=/path/to/.env ./up.sh` (see up.sh). US-residency keys need
# OPENAI_BASE_URL=https://us.api.openai.com/v1 (the compose default).
ANTHROPIC_API_KEY=

# Passed through to process-adapter agents running ./app (TinyFish primitives).
TINYFISH_API_KEY=
ELEVENLABS_API_KEY=
BRIGHTDATA_API_KEY=
AGENTMAIL_API_KEY=
